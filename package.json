{
  "name": "footprint-album",
  "private": true,
  "version": "0.1.0",
  "description": "足迹相册 — 从照片 EXIF 生成足迹地图与旅行相册的开源 Web 应用",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "build-cities": "node scripts/build-cities.mjs",
    "build:worker": "vite build --config vite.worker.config.ts"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "exifr": "^7.1.3",
    "maplibre-gl": "^6.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "supercluster": "^9.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "url": "https://github.com/ElouDi/footprint-album.git"
  },
  "homepage": "https://eloudi.github.io/footprint-album/"
}
